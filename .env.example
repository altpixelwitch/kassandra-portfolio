# Railway supplies DATABASE_URL automatically when a PostgreSQL service is linked.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kassandra

# Generate with: openssl rand -base64 48
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Set this to the exact public HTTPS origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-app.up.railway.app

# Railway volume mount. Keep this value as shown in production.
UPLOADS_DIR=/app/uploads
